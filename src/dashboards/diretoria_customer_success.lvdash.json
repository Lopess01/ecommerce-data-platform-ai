{
  "datasets": [
    {
      "name": "ds_clientes",
      "displayName": "Clientes (uma linha por cliente)",
      "queryLines": [
        "SELECT\n",
        "  ranking_receita,\n",
        "  id_cliente,\n",
        "  nome_cliente,\n",
        "  estado,\n",
        "  nome_estado,\n",
        "  regiao,\n",
        "  segmento_cliente,\n",
        "  total_compras,\n",
        "  receita,\n",
        "  CASE WHEN segmento_cliente = 'VIP' THEN receita ELSE 0 END AS receita_vip,\n",
        "  CASE WHEN segmento_cliente = 'VIP' THEN 1 ELSE 0 END AS eh_vip,\n",
        "  ultima_compra\n",
        "FROM clientes_segmentacao\n",
        "ORDER BY ranking_receita\n"
      ],
      "columns": [
        {
          "displayName": "Clientes",
          "description": "Número de clientes (inclui quem nunca comprou).",
          "expression": "COUNT(`id_cliente`)"
        },
        {
          "displayName": "Clientes VIP",
          "description": "Clientes com receita a partir de R$ 22.000.",
          "expression": "SUM(`eh_vip`)"
        },
        {
          "displayName": "% da receita dos VIP",
          "description": "Receita dos clientes VIP dividida pela receita total (0 a 1).",
          "expression": "SUM(`receita_vip`) / SUM(`receita`)"
        },
        {
          "displayName": "Ticket médio",
          "description": "Receita total dividida pelo total de compras, em R$ (não é média de médias).",
          "expression": "SUM(`receita`) / SUM(`total_compras`)"
        }
      ]
    }
  ],
