{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas (uma linha por venda)",
      "queryLines": [
        "SELECT\n",
        "  id_venda,\n",
        "  data,\n",
        "  dia_semana,\n",
        "  hora,\n",
        "  concat(lpad(CAST(hora AS STRING), 2, '0'), 'h') AS hora_rotulo,\n",
        "  CASE canal_venda WHEN 'ecommerce' THEN 'E-commerce' WHEN 'loja_fisica' THEN 'Loja física' END AS canal,\n",
        "  categoria,\n",
        "  quantidade,\n",
        "  receita\n",
        "FROM vendas_detalhadas\n"
      ],
      "columns": [
        {
          "displayName": "Vendas",
          "description": "Número de vendas (pedidos).",
          "expression": "COUNT(`id_venda`)"
        },
        {
          "displayName": "Ticket médio",
          "description": "Receita total dividida pelo número de vendas, em R$ (não é média de médias).",
          "expression": "SUM(`receita`) / COUNT(`id_venda`)"
        },
        {
          "displayName": "Itens vendidos",
          "description": "Soma das unidades vendidas.",
          "expression": "SUM(`quantidade`)"
        },
        {
          "displayName": "Receita média por dia",
          "description": "Receita dividida pelo número de dias com venda: compara dias da semana que aparecem 4 ou 5 vezes no período.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `data`)"
        }
      ]
    },
    {
      "name": "ds_top10",
      "displayName": "Top 10 produtos por receita",
      "queryLines": [
        "SELECT\n",
        "  ROW_NUMBER() OVER (ORDER BY SUM(receita) DESC, id_produto) AS posicao,\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  COUNT(*) AS vendas,\n",
        "  SUM(quantidade) AS itens_vendidos,\n",
        "  SUM(receita) AS receita,\n",
        "  SUM(receita) / COUNT(*) AS ticket_medio\n",
        "FROM vendas_detalhadas\n",
        "WHERE data BETWEEN :periodo.min AND :periodo.max\n",
        "  AND (size(:canal) = 0 OR array_contains(:canal, CASE canal_venda WHEN 'ecommerce' THEN 'E-commerce' WHEN 'loja_fisica' THEN 'Loja física' END))\n",
        "GROUP BY id_produto, nome_produto, categoria\n",
        "ORDER BY receita DESC, id_produto\n",
        "LIMIT 10\n"
      ],
      "parameters": [
        {
          "displayName": "periodo",
          "keyword": "periodo",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2025-12-13T00:00:00.000"
              },
              "max": {
                "value": "2026-01-11T00:00:00.000"
              }
            }
          }
        },
        {
          "displayName": "canal",
          "keyword": "canal",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": []
            }
          }
        }
      ]
    }
  ],
