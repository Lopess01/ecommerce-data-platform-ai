{
  "datasets": [
    {
      "name": "ds_precos",
      "displayName": "Preços vs. concorrência (uma linha por produto)",
      "queryLines": [
        "SELECT\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  marca,\n",
        "  CASE classificacao_preco\n",
        "    WHEN 'MAIS_CARO_QUE_TODOS' THEN 'Mais caro que todos'\n",
        "    WHEN 'ACIMA_DA_MEDIA' THEN 'Acima da média'\n",
        "    WHEN 'NA_MEDIA' THEN 'Na média'\n",
        "    WHEN 'ABAIXO_DA_MEDIA' THEN 'Abaixo da média'\n",
        "    WHEN 'MAIS_BARATO_QUE_TODOS' THEN 'Mais barato que todos'\n",
        "  END AS classificacao,\n",
        "  classificacao_preco,\n",
        "  possui_preco_suspeito,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'Preço suspeito (conferir)' ELSE 'Confirmado' END AS situacao_preco,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'Sim' ELSE 'Não' END AS preco_a_confirmar,\n",
        "  nosso_preco,\n",
        "  preco_medio_concorrentes,\n",
        "  preco_minimo_concorrentes,\n",
        "  total_concorrentes,\n",
        "  diferenca_pct_vs_media / 100 AS diferenca_vs_media,\n",
        "  diferenca_pct_vs_minimo / 100 AS diferenca_vs_minimo,\n",
        "  receita,\n",
        "  itens_vendidos,\n",
        "  CASE WHEN classificacao_preco = 'MAIS_CARO_QUE_TODOS' AND NOT possui_preco_suspeito THEN 1 ELSE 0 END AS caro_confirmado,\n",
        "  CASE WHEN possui_preco_suspeito THEN 1 ELSE 0 END AS suspeito\n",
        "FROM precos_competitividade\n",
        "ORDER BY receita DESC, id_produto\n"
      ],
      "columns": [
        {
          "displayName": "Produtos monitorados",
          "description": "Produtos com preço de concorrente (contados por id_produto).",
          "expression": "COUNT(`id_produto`)"
        },
        {
          "displayName": "Mais caros confirmados",
          "description": "Produtos mais caros que todos os concorrentes, sem preço suspeito.",
          "expression": "SUM(`caro_confirmado`)"
        },
        {
          "displayName": "Receita dos mais caros confirmados",
          "description": "Receita no período dos produtos mais caros que todos, sem preço suspeito, em R$.",
          "expression": "SUM(CASE WHEN `caro_confirmado` = 1 THEN `receita` ELSE 0 END)"
        },
        {
          "displayName": "Preços suspeitos a conferir",
          "description": "Produtos com algum preço de concorrente abaixo de 60% do nosso (erro de coleta ou promoção).",
          "expression": "SUM(`suspeito`)"
        },
        {
          "displayName": "Diferença média vs. mercado",
          "description": "Média da diferença do nosso preço para a média dos concorrentes (0,01 = 1% mais caro).",
          "expression": "AVG(`diferenca_vs_media`)"
        }
      ]
    }
  ],
